<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 的根目录。注意：每个 name 必须唯一！
     FileProvider 用 name 做 HashMap 的键，重名时后一条会覆盖前一条。
     v4.11 及以前这里两条都叫 "update"，cache-path 覆盖了 external-cache-path，
     而更新包下载在 externalCacheDir（/storage/emulated/0/Android/data/…/cache），
     于是 getUriForFile 报 "Failed to find configured root that contains /storage/…"。
     现在更新包固定下载到内部缓存 cacheDir/updates/（AppUpdater.updateDir），
     由下面第一条覆盖；第二条只为兼容外部缓存里的文件，name 不同、互不覆盖。
     单元测试 FileProviderPathsTest / AppUpdaterFileProviderTest 会检查这一点。 -->
<paths>
    <cache-path name="app_updates" path="updates/" />
    <external-cache-path name="external_cache" path="." />
</paths>
