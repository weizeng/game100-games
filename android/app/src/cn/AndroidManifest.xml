<?xml version="1.0" encoding="utf-8"?>
<!-- cn 渠道（国内应用商店）：离线保底 + 联网增量更新新游戏。
     构建时把 games/ 全部打进 APK（assets/bundled），无网也能玩已内置的游戏；
     有网时读线上 manifest，下载尚未内置的新游戏。不自更新 APK（商店政策）。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 保留 main 的 INTERNET / ACCESS_NETWORK_STATE，供游戏目录增量更新 -->
    <application android:usesCleartextTraffic="false" tools:replace="android:usesCleartextTraffic" />
</manifest>
