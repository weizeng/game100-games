<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg">
    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:id="@+id/toolbar"
        android:background="@color/bg"
        app:title="@string/app_name"
        app:titleTextColor="@color/text_primary"
        app:titleTextAppearance="@style/ToolbarTitle"
        app:menu="@menu/menu_main" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/text_secondary"
        android:textAppearance="@style/TextAppearance.Game100.Body"
        android:id="@+id/tv_subtitle"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:textSize="13sp" />
    <EditText
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:id="@+id/search_bar"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/search_bg"
        android:hint="搜索你想玩的游戏"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:singleLine="true"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no" />

    <!-- 🔬 科学实验室入口 -->
    <LinearLayout
        android:id="@+id/science_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/science_banner_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔬"
            android:textSize="36sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="科学实验室"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50 个理化生实验 · 动手学科学"
                android:textSize="13sp"
                android:textColor="#E0E0E0" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="28sp"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/cat_scroll"
        android:scrollbars="none"
        android:fillViewport="false"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/cat_row"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </HorizontalScrollView>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/swipe"
        android:layout_weight="1">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="发现好游戏"
                    android:textColor="@color/text_primary"
                    android:id="@+id/feat_title"
                    android:textAppearance="@style/TextAppearance.Game100.Section"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone" />
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/feat_recycler"
                    android:clipToPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="全部游戏"
                        android:textColor="@color/text_primary"
                        android:id="@+id/tv_games_title"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Game100.Section" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Game100.Body"
                        android:id="@+id/tv_result_count"
                        android:textSize="12sp" />
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/recycler"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    android:paddingBottom="24dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/empty_state"
                    android:gravity="center"
                    android:padding="28dp"
                    android:layout_margin="20dp"
                    android:background="@drawable/surface_panel"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⌕"
                        android:textColor="@color/brand"
                        android:textSize="42sp"
                        android:gravity="center"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="试试其他关键词或分类"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Game100.Body"
                        android:id="@+id/tv_empty"
                        android:gravity="center"
                        android:textSize="15sp"
                        android:layout_marginTop="12dp" />
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/btn_reset_filters"
                        style="@style/Widget.Game100.SecondaryButton"
                        android:text="查看全部游戏"
                        android:layout_marginTop="20dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
