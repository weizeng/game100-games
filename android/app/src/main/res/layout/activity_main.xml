<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app">
    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:id="@+id/toolbar"
        android:background="@android:color/transparent"
        android:paddingStart="6dp"
        app:title=""
        app:menu="@menu/menu_main">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:contentDescription="@string/app_name">
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/logo_tile"
                android:importantForAccessibility="no" />
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="27dp"
                android:layout_marginStart="10dp"
                android:adjustViewBounds="true"
                android:src="@drawable/wordmark"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/swipe"
        android:layout_weight="1">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/home_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/home_appbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:elevation="0dp"
                app:liftOnScroll="false">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_scrollFlags="scroll|snapMargins">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Game100.Body"
                        android:id="@+id/tv_subtitle"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="10dp"
                        android:textSize="13sp" />
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:id="@+id/search_bar"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/search_bg"
                        android:hint="搜索 500 款游戏、玩法或出品方"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="14sp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:drawableStart="@drawable/ic_search"
                        android:drawablePadding="10dp"
                        android:singleLine="true"
                        android:inputType="text"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no" />
                    <!-- 500 款高频快捷条：随机来一局 / 我的收藏 / 排序切换 -->
                    <LinearLayout
                        android:id="@+id/quick_actions_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="12dp">
                        <TextView
                            android:id="@+id/btn_quick_random"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1.25"
                            android:gravity="center"
                            android:text="@string/quick_random"
                            android:textColor="@color/coin_ink"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:paddingBottom="2dp"
                            android:background="@drawable/pill_action"
                            android:clickable="true"
                            android:focusable="true" />
                        <TextView
                            android:id="@+id/btn_quick_fav"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:text="@string/quick_favorites"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:paddingBottom="2dp"
                            android:background="@drawable/pill_secondary"
                            android:clickable="true"
                            android:focusable="true" />
                        <TextView
                            android:id="@+id/btn_quick_sort"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="0.95"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:text="@string/sort_default"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:paddingBottom="2dp"
                            android:background="@drawable/pill_secondary"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/cat_scroll"
                        android:scrollbars="none"
                        android:fillViewport="false"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:id="@+id/cat_row"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp" />
                    </HorizontalScrollView>
                    <!-- 出品方筛选：全部 / ✦ Muse 出品 / ◆ Grok 出品（按游戏里实际出现的出品方动态生成） -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/studio_scroll"
                        android:scrollbars="none"
                        android:layout_marginTop="-4dp"
                        android:paddingBottom="10dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:id="@+id/studio_row"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="出品方"
                                android:textColor="@color/text_dim"
                                android:textSize="12sp"
                                android:layout_marginEnd="8dp"
                                android:importantForAccessibility="no" />
                        </LinearLayout>
                    </HorizontalScrollView>
                    <LinearLayout
                        android:id="@+id/science_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp"
                        android:background="@drawable/science_banner_bg"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:gravity="center"
                            android:text="🔬"
                            android:textSize="26sp"
                            android:background="@drawable/science_icon_bg"
                            android:importantForAccessibility="no" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="科学实验室"
                                android:textSize="16.5sp"
                                android:textStyle="bold"
                                android:textColor="#FF042A20" />
                            <TextView
                                android:id="@+id/science_summary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="物理 / 化学 / 生物"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#D9042A20" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="进入 ›"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#FF042A20"
                            android:paddingStart="11dp"
                            android:paddingEnd="11dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:background="@drawable/pill_secondary"
                            android:backgroundTint="#D9FFFFFF"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/continue_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone">
                        <View
                            android:layout_width="4dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/section_accent" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="▶ 接着玩"
                                android:textColor="@color/text_primary"
                                android:id="@+id/continue_title"
                                android:textAppearance="@style/TextAppearance.Game100.Section" />
                            <TextView
                                android:id="@+id/continue_subtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="上次停在这儿"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/continue_recycler"
                        android:clipToPadding="false"
                        android:paddingStart="20dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />
                    <LinearLayout
                        android:id="@+id/feat_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone">
                        <View
                            android:layout_width="4dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/section_accent" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="✦ 为你推荐"
                                android:textColor="@color/text_primary"
                                android:id="@+id/feat_title"
                                android:textAppearance="@style/TextAppearance.Game100.Section" />
                            <TextView
                                android:id="@+id/feat_subtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="新鲜 · 多样 · 懂你口味"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_more_featured"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="更多"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            android:textColor="@color/brand"
                            style="@style/Widget.Game100.TextButton" />
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/feat_recycler"
                        android:clipToPadding="false"
                        android:paddingStart="20dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />
                    <LinearLayout
                        android:id="@+id/new_section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone">
                        <View
                            android:layout_width="4dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/section_accent" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="✨ 新游戏"
                                android:textColor="@color/text_primary"
                                android:id="@+id/new_title"
                                android:textAppearance="@style/TextAppearance.Game100.Section" />
                            <TextView
                                android:id="@+id/new_subtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="刚上线 / 刚升级"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_more_new"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="全部新游"
                            android:textSize="13sp"
                            android:textAllCaps="false"
                            android:textColor="@color/brand"
                            style="@style/Widget.Game100.TextButton" />
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/new_recycler"
                        android:clipToPadding="false"
                        android:paddingStart="20dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />
                </LinearLayout>
                <!-- 列表标题条固定在主网格上方，随用户下滑自然吸附 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="🗂 全部游戏"
                        android:textColor="@color/text_primary"
                        android:id="@+id/tv_games_title"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Game100.Section" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Game100.Body"
                        android:id="@+id/tv_result_count"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/recycler"
                    android:clipToPadding="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="28dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/empty_state"
                    android:gravity="center"
                    android:padding="28dp"
                    android:layout_margin="20dp"
                    android:background="@drawable/surface_panel"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🛸"
                        android:textSize="36sp"
                        android:gravity="center"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/tv_empty"
                        android:text="没有找到相关游戏"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Game100.Body"
                        android:gravity="center"
                        android:layout_marginTop="10dp" />
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:id="@+id/btn_reset_filters"
                        android:layout_marginTop="16dp"
                        android:text="查看全部游戏"
                        style="@style/Widget.Game100.PrimaryButton" />
                </LinearLayout>
            </FrameLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
