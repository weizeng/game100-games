<?xml version="1.0" encoding="utf-8"?>
<!-- 精选轮播卡：游戏主色糖果渐变 + 白描边 + 台阶阴影（背景由 GameAdapter.featuredBackground 生成） -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="186dp"
    android:layout_marginEnd="12dp">
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/feat_bg" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="7dp"
        android:foreground="?attr/selectableItemBackground">
        <com.game100.center.ui.ArcadeBackdropView
            android:id="@+id/feat_effects"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <TextView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:text="🎮"
            android:textColor="@color/text_primary"
            android:id="@+id/feat_icon"
            android:gravity="center"
            android:layout_gravity="top|end"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="16dp"
            android:rotation="-6"
            android:textSize="52sp"
            android:background="@drawable/feat_emblem"
            android:paddingBottom="5dp"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="精选推荐"
                android:textColor="#FF2B0F63"
                android:id="@+id/feat_kicker"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/pill_secondary"
                android:backgroundTint="#EBFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="游戏名"
                android:textColor="@android:color/white"
                android:id="@+id/feat_name"
                android:textSize="26sp"
                android:textStyle="bold"
                android:shadowColor="#73000000"
                android:shadowDy="4"
                android:shadowRadius="0.01"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:text="描述"
                android:textColor="#F2FFFFFF"
                android:id="@+id/feat_desc"
                android:layout_marginTop="3dp"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp"
                android:shadowColor="#40000000"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
