<?xml version="1.0" encoding="utf-8"?>
<!-- 首页游戏卡片（3 列网格）：糖果图标 + 名称 + 状态 + 立体操作按钮。id 与旧列表行一致，适配器逻辑不变。 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_margin="5dp"
    android:paddingTop="14dp"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="15dp"
    android:background="@drawable/surface_panel"
    android:foreground="?attr/selectableItemBackground">
    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="72dp"
        android:importantForAccessibility="noHideDescendants">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/row_icon_bg" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮"
            android:textColor="@color/text_primary"
            android:id="@+id/row_icon"
            android:layout_gravity="center"
            android:layout_marginBottom="2dp"
            android:textSize="34sp"
            android:shadowColor="#40000000"
            android:shadowDy="3"
            android:shadowRadius="0.01" />
    </FrameLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="游戏名"
        android:textColor="@color/text_primary"
        android:id="@+id/row_name"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="分类"
        android:textColor="@color/text_secondary"
        android:id="@+id/row_sub"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/accent"
        android:id="@+id/row_rating"
        android:gravity="center"
        android:textSize="10sp"
        android:visibility="gone" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="开玩"
        android:textColor="@color/coin_ink"
        android:id="@+id/row_action"
        android:layout_marginTop="8dp"
        android:minWidth="72dp"
        android:minHeight="40dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="3dp"
        android:background="@drawable/pill_action"
        android:textSize="13sp"
        android:textStyle="bold"
        android:focusable="true"
        android:clickable="true" />
</LinearLayout>
