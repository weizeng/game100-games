<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="24dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="正在准备你的游戏"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="完成后即可离线游玩。"
        android:textColor="@color/text_secondary"
        android:textAppearance="@style/TextAppearance.Game100.Body"
        android:layout_marginTop="8dp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textColor="@color/cyan"
        android:id="@+id/dl_text"
        android:layout_marginTop="24dp"
        android:textSize="28sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/text_secondary"
        android:id="@+id/dl_status"
        android:layout_marginTop="4dp"
        android:textSize="13sp" />
    <ProgressBar
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:id="@+id/dl_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_marginTop="14dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_candy"
        android:indeterminateTint="@color/cyan" />
</LinearLayout>
