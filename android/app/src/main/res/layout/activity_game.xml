<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/stage">
    <WebView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/webview" />
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/progress"
        android:layout_gravity="center"
        android:indeterminateTint="@color/mint" />
    <!-- 顶部角落可收起半透明胶囊：不遮挡底部操作区，展开可重开/收藏/下一款随机/反馈/返回 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        android:gravity="end">
        <TextView
            android:id="@+id/quick_fab"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="☰"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:alpha="0.72"
            android:background="@drawable/pill_dark"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/quick_menu_open" />
        <LinearLayout
            android:id="@+id/quick_menu_panel"
            android:layout_width="148dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/surface_panel"
            android:visibility="gone">
            <TextView
                android:id="@+id/quick_restart"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="🔄 重开本局"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/quick_fav"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="♡ 收藏游戏"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/quick_random"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="🎲 随机下一款"
                android:textColor="@color/accent"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/quick_feedback"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="💬 反馈问题"
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@color/divider" />
            <TextView
                android:id="@+id/quick_exit"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="🏠 返回大厅"
                android:textColor="@color/mint"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
