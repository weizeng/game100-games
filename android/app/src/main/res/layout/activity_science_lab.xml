<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/science_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:title="科学实验室"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_back"
        app:navigationContentDescription="返回首页" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="动手试一试，让知识看得见。"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">
        <LinearLayout
            android:id="@+id/subject_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </HorizontalScrollView>
    <TextView
        android:id="@+id/science_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="正在加载实验…"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/science_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="暂无相关实验，返回首页下拉刷新后再试。"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/science_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="14dp" />
</LinearLayout>
