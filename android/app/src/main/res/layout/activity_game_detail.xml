<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页（皮肤 B 升级版）：头图 + 快捷事实条 + 清洗后简介 + 排行榜 + 全服评分/标签/短评 + 同类推荐 -->
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_app">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp">
                <View
                    android:id="@+id/detail_hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/hero_rays"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="128dp"
                    android:layout_height="134dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="74dp"
                    android:text="🎮"
                    android:textColor="@color/text_primary"
                    android:id="@+id/detail_icon"
                    android:gravity="center"
                    android:paddingBottom="6dp"
                    android:textSize="64sp"
                    android:shadowColor="#40000000"
                    android:shadowDy="5"
                    android:shadowRadius="0.01"
                    android:importantForAccessibility="no" />
            </FrameLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-32dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:text="游戏名"
                android:textColor="@color/text_primary"
                android:id="@+id/detail_name"
                android:gravity="center"
                android:textSize="28sp"
                android:textStyle="bold"
                android:shadowColor="@color/pink_edge"
                android:shadowDy="6"
                android:shadowRadius="0.01"
                android:maxLines="2"
                android:ellipsize="end" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="分类"
                    android:textColor="@color/text_primary"
                    android:id="@+id/detail_category"
                    android:minHeight="32dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/pill_secondary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="v1"
                    android:textColor="@color/text_primary"
                    android:id="@+id/detail_version"
                    android:minHeight="32dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/pill_secondary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="出品方"
                    android:textColor="@android:color/white"
                    android:id="@+id/detail_studio"
                    android:minHeight="32dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/pill_studio"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
            <!-- 快捷事实条：全服评分 / 离线状态 / 个人最高分 -->
            <LinearLayout
                android:id="@+id/detail_facts_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:orientation="horizontal"
                android:background="@drawable/surface_panel"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/detail_fact_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★ 待评分"
                        android:textColor="@color/accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/detail_fact_rating_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="玩家评价"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/divider" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/detail_fact_offline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✔ 离线可玩"
                        android:textColor="@color/mint"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/detail_fact_offline_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="断网秒开"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/divider" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/detail_fact_best"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯 首局待开"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="个人纪录"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp">
                <com.google.android.material.button.MaterialButton
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:id="@+id/btn_play"
                    style="@style/Widget.Game100.PrimaryButton"
                    android:text="开始游戏"
                    android:layout_weight="1" />
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="♡"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/btn_favorite"
                    android:layout_marginStart="12dp"
                    android:gravity="center"
                    android:paddingBottom="4dp"
                    android:textSize="28sp"
                    android:background="@drawable/btn_glass"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="收藏游戏" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_secondary"
                android:id="@+id/detail_size"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="14dp"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="12sp" />
            <!-- 游戏介绍 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_panel"
                android:padding="18dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="14dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📖 玩法介绍"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.Game100.Section"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="暂无简介"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Game100.Body"
                    android:id="@+id/detail_desc"
                    android:lineSpacingExtra="4dp"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/coin_ink"
                    android:id="@+id/detail_best_score"
                    android:layout_marginTop="14dp"
                    android:padding="12dp"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/pill_action"
                    android:visibility="gone" />
            </LinearLayout>
            <!-- 全服排行榜 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_panel"
                android:padding="18dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="14dp"
                android:id="@+id/leaderboard_panel"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/leaderboard_title"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.Game100.Section"
                    android:id="@+id/leaderboard_status"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Game100.Body"
                    android:id="@+id/leaderboard_list"
                    android:lineSpacingExtra="6dp"
                    android:textSize="14.5sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/coin_ink"
                    android:id="@+id/leaderboard_mine"
                    android:layout_marginTop="10dp"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <!-- 玩家评价与印象标签（云端 + 本地兜底） -->
            <LinearLayout
                android:id="@+id/reviews_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_panel"
                android:padding="18dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⭐ 玩家评价"
                        android:textColor="@color/text_primary"
                        android:textAppearance="@style/TextAppearance.Game100.Section" />
                    <TextView
                        android:id="@+id/review_summary_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <!-- 全服热门印象标签统计 -->
                <HorizontalScrollView
                    android:id="@+id/review_top_tags_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone">
                    <LinearLayout
                        android:id="@+id/review_top_tags_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="点星评分，选几个印象标签或写句短评，帮助大家避坑选好游。"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Game100.Body"
                    android:textSize="13sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:id="@+id/stars_row"
                    android:gravity="center"
                    android:layout_marginTop="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Game100.Body"
                    android:id="@+id/detail_rating_text"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp" />
                <!-- 快捷印象标签选择区（2 行 × 3 个，最多选 3 个） -->
                <LinearLayout
                    android:id="@+id/review_tags_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp" />
                <EditText
                    android:id="@+id/review_comment_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:layout_marginTop="10dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/search_bg"
                    android:hint="@string/reviews_comment_hint"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_dim"
                    android:textSize="13.5sp"
                    android:maxLength="200"
                    android:maxLines="3"
                    android:inputType="textMultiLine"
                    android:importantForAutofill="no" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_submit_review"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/reviews_submit"
                    android:textSize="14sp"
                    style="@style/Widget.Game100.PrimaryButton" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/divider" />
                <TextView
                    android:id="@+id/reviews_empty_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reviews_empty"
                    android:textColor="@color/text_dim"
                    android:textSize="12.5sp"
                    android:gravity="center" />
                <LinearLayout
                    android:id="@+id/reviews_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
            <!-- 同类推荐 -->
            <LinearLayout
                android:id="@+id/similar_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="10dp"
                    android:text="@string/similar_games_title"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.Game100.Section" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/similar_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="18dp"
                    android:paddingEnd="12dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:id="@+id/detail_toolbar"
        android:background="@android:color/transparent"
        app:title=""
        app:navigationIcon="@drawable/ic_back"
        app:navigationContentDescription="@string/back" />
</FrameLayout>
