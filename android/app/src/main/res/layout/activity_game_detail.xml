<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页（皮肤 B）：游戏主色头图 + 放射光 + 大号糖果图标；名称、分类、出品方居中；金币「开始游戏」大按钮。 -->
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_app">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="290dp">
                <View
                    android:id="@+id/detail_hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/hero_rays"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="132dp"
                    android:layout_height="138dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="78dp"
                    android:text="🎮"
                    android:textColor="@color/text_primary"
                    android:id="@+id/detail_icon"
                    android:gravity="center"
                    android:paddingBottom="6dp"
                    android:textSize="68sp"
                    android:shadowColor="#40000000"
                    android:shadowDy="5"
                    android:shadowRadius="0.01"
                    android:importantForAccessibility="no" />
            </FrameLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-34dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:text="游戏名"
                android:textColor="@color/text_primary"
                android:id="@+id/detail_name"
                android:gravity="center"
                android:textSize="30sp"
                android:textStyle="bold"
                android:shadowColor="@color/pink_edge"
                android:shadowDy="6"
                android:shadowRadius="0.01"
                android:maxLines="2"
                android:ellipsize="end" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="分类"
                    android:textColor="@color/text_primary"
                    android:id="@+id/detail_category"
                    android:minHeight="32dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/pill_secondary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="出品方"
                    android:textColor="@android:color/white"
                    android:id="@+id/detail_studio"
                    android:minHeight="32dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/pill_studio"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp">
                <com.google.android.material.button.MaterialButton
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:id="@+id/btn_play"
                    style="@style/Widget.Game100.PrimaryButton"
                    android:text="开始游戏"
                    android:layout_weight="1" />
                <TextView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:text="♡"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/btn_favorite"
                    android:layout_marginStart="12dp"
                    android:gravity="center"
                    android:paddingBottom="4dp"
                    android:textSize="28sp"
                    android:background="@drawable/btn_glass"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="收藏游戏" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_secondary"
                android:id="@+id/detail_size"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="12sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_panel"
                android:padding="18dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="游戏介绍"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.Game100.Section"
                    android:layout_marginBottom="12dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="暂无简介"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Game100.Body"
                    android:id="@+id/detail_desc"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/coin_ink"
                    android:id="@+id/detail_best_score"
                    android:layout_marginTop="18dp"
                    android:padding="14dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/pill_action"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_panel"
                android:padding="18dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="这款游戏怎么样？"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.Game100.Section"
                    android:layout_marginBottom="12dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="记下你的体验，下次选游戏更轻松。"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Game100.Body" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:id="@+id/stars_row"
                    android:gravity="center"
                    android:layout_marginTop="12dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Game100.Body"
                    android:id="@+id/detail_rating_text"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:id="@+id/detail_toolbar"
        android:background="@android:color/transparent"
        app:title=""
        app:navigationIcon="@drawable/ic_back"
        app:navigationContentDescription="@string/back" />
</FrameLayout>
