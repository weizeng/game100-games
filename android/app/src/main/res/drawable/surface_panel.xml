<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃面板：半透明白 + 细描边 + 底部实色台阶 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="@color/ledge" /><corners android:radius="24dp" /></shape></item>
    <item android:bottom="5dp"><shape>
        <gradient android:angle="270" android:startColor="@color/glass_top" android:endColor="@color/glass_bottom" />
        <stroke android:width="1dp" android:color="@color/glass_line" />
        <corners android:radius="24dp" /></shape></item>
</layer-list>
