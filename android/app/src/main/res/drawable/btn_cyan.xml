<?xml version="1.0" encoding="utf-8"?>
<!-- 立体按钮：底层“台阶”+ 渐变面；按下时面下沉。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><layer-list>
        <item android:top="0dp"><shape android:shape="rectangle"><solid android:color="@color/cyan_edge" /><corners android:radius="18dp" /></shape></item>
        <item android:top="0dp" android:bottom="5dp"><shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/cyan_hi" android:centerColor="@color/cyan" android:endColor="@color/cyan_lo" />
            <stroke android:width="1.5dp" android:color="@color/cyan_line" />
            <corners android:radius="18dp" /></shape></item>
        <item android:bottom="5dp"><shape android:shape="rectangle"><solid android:color="#73120530" /><corners android:radius="18dp" /></shape></item>
    </layer-list></item>
    <item android:state_pressed="true"><layer-list>
        <item android:top="4dp"><shape android:shape="rectangle"><solid android:color="@color/cyan_edge" /><corners android:radius="18dp" /></shape></item>
        <item android:top="4dp" android:bottom="1dp"><shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/cyan_hi" android:centerColor="@color/cyan" android:endColor="@color/cyan_lo" />
            <stroke android:width="1.5dp" android:color="@color/cyan_line" />
            <corners android:radius="18dp" /></shape></item>
    </layer-list></item>
    <item><layer-list>
        <item android:top="0dp"><shape android:shape="rectangle"><solid android:color="@color/cyan_edge" /><corners android:radius="18dp" /></shape></item>
        <item android:top="0dp" android:bottom="5dp"><shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/cyan_hi" android:centerColor="@color/cyan" android:endColor="@color/cyan_lo" />
            <stroke android:width="1.5dp" android:color="@color/cyan_line" />
            <corners android:radius="18dp" /></shape></item>
    </layer-list></item>
</selector>
