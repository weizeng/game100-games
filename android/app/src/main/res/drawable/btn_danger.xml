<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><layer-list>
        <item android:top="3dp"><shape><solid android:color="@color/danger_edge" /><corners android:radius="18dp" /></shape></item>
        <item android:top="3dp" android:bottom="1dp"><shape><gradient android:angle="270" android:startColor="#47FF5A6E" android:endColor="#29FF5A6E" /><stroke android:width="1dp" android:color="#73FF8C9B" /><corners android:radius="18dp" /></shape></item>
    </layer-list></item>
    <item><layer-list>
        <item><shape><solid android:color="@color/danger_edge" /><corners android:radius="18dp" /></shape></item>
        <item android:bottom="4dp"><shape><gradient android:angle="270" android:startColor="#47FF5A6E" android:endColor="#29FF5A6E" /><stroke android:width="1dp" android:color="#73FF8C9B" /><corners android:radius="18dp" /></shape></item>
    </layer-list></item>
</selector>
