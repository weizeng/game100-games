<?xml version="1.0" encoding="utf-8"?>
<!-- 分类宫格：玻璃面 + 台阶阴影 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/ledge" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:startColor="@color/glass_top"
                android:endColor="@color/glass_bottom"
                android:angle="270" />
            <stroke android:width="1dp" android:color="@color/glass_line" />
        </shape>
    </item>
</layer-list>
