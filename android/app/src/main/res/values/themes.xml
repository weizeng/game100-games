<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 皮肤 B「霓虹糖果 Pop Arcade」：深色街机外壳，和游戏内皮肤 B 一致。 -->
    <style name="Base.Theme.Game100" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/coin</item>
        <item name="colorPrimaryDark">@color/bg_top</item>
        <item name="colorAccent">@color/cyan</item>
        <item name="colorSecondary">@color/cyan</item>
        <item name="colorOnPrimary">@color/coin_ink</item>
        <item name="colorOnSecondary">@color/cyan_ink</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@color/bg_top</item>
        <item name="android:navigationBarColor">@color/bg_bottom</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorSurface">@color/bg_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/coin</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorEdgeEffect">@color/pink</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Game100.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Game100.Dialog</item>
    </style>
    <style name="Theme.Game100" parent="Base.Theme.Game100" />

    <style name="ThemeOverlay.Game100.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="colorPrimary">@color/coin</item>
        <item name="colorAccent">@color/coin</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Game100.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Game100.DialogButton.Muted</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Game100.DialogButton.Muted</item>
    </style>
    <style name="Widget.Game100.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/coin</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Game100.DialogButton.Muted">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:shadowColor">@color/pink_edge</item>
        <item name="android:shadowDy">5</item>
        <item name="android:shadowRadius">0.01</item>
    </style>

    <style name="TextAppearance.Game100.Section" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:shadowColor">@color/pink_edge</item>
        <item name="android:shadowDy">4</item>
        <item name="android:shadowRadius">0.01</item>
    </style>
    <style name="TextAppearance.Game100.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">5dp</item>
    </style>
    <style name="Widget.Game100.TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/cyan</item>
        <item name="rippleColor">@color/ripple</item>
    </style>
    <!-- 立体按钮：自定义 background，必须清掉 MaterialButton 的 backgroundTint 和阴影动画 -->
    <style name="Widget.Game100.Button3D" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>
    <style name="Widget.Game100.PrimaryButton" parent="Widget.Game100.Button3D">
        <item name="android:background">@drawable/btn_coin</item>
        <item name="android:textColor">@color/coin_ink</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="Widget.Game100.SecondaryButton" parent="Widget.Game100.Button3D">
        <item name="android:background">@drawable/btn_glass</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.Game100.DangerButton" parent="Widget.Game100.SecondaryButton">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">@color/danger_ink</item>
    </style>
</resources>
