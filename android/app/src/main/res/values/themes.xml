<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Game100" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorEdgeEffect">@color/brand_soft</item>
    </style>

    <style name="ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Game100.Section" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Game100.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">5dp</item>
    </style>
    <style name="Widget.Game100.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/brand</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="Widget.Game100.SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/brand</item>
        <item name="strokeColor">@color/divider</item>
        <item name="backgroundTint">@color/bg_card</item>
        <item name="cornerRadius">16dp</item>
    </style>
    <style name="Widget.Game100.DangerButton" parent="Widget.Game100.SecondaryButton">
        <item name="android:textColor">@color/badge_red</item>
        <item name="backgroundTint">@color/danger_soft</item>
        <item name="strokeColor">@color/danger_soft</item>
    </style>
</resources>
