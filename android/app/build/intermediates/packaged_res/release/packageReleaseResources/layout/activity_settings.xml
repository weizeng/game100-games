<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg">
    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:id="@+id/settings_toolbar"
        android:background="@color/bg"
        app:title="设置"
        app:titleTextColor="@color/text_primary"
        app:titleTextAppearance="@style/TextAppearance.Game100.Section"
        app:navigationIcon="@drawable/ic_back"
        app:navigationContentDescription="@string/back" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_panel"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="游戏内容来源"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.Game100.Section"
                    android:layout_marginBottom="12dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="默认游戏库已配置好，也可以换成自己的游戏源。"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Game100.Body" />
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/et_url"
                    android:layout_marginTop="16dp"
                    android:minHeight="56dp"
                    android:background="@drawable/search_bg"
                    android:padding="14dp"
                    android:hint="@string/manifest_url_hint"
                    android:inputType="textUri"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:maxLines="3"
                    android:importantForAutofill="no"
                    android:contentDescription="@string/manifest_url_label" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/btn_save"
                        style="@style/Widget.Game100.PrimaryButton"
                        android:text="保存设置"
                        android:layout_weight="1" />
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/btn_default"
                        style="@style/Widget.Game100.SecondaryButton"
                        android:text="恢复默认"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_panel"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="随时开玩"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.Game100.Section"
                    android:layout_marginBottom="12dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_text"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Game100.Body" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_panel"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="关于游戏100"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.Game100.Body"
                            android:id="@+id/tv_version"
                            android:layout_marginTop="6dp"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/btn_check_update"
                        style="@style/Widget.Game100.SecondaryButton"
                        android:text="检查更新"
                        android:layout_marginStart="12dp"
                        android:minWidth="100dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_panel"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="下载管理"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.Game100.Section"
                    android:layout_marginBottom="12dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="移除本机的游戏文件，需要时可以重新下载。"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Game100.Body" />
                <com.google.android.material.button.MaterialButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/btn_clear"
                    style="@style/Widget.Game100.DangerButton"
                    android:text="清除已下载游戏"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
