<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg">
    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:id="@+id/detail_toolbar"
        android:background="@color/bg"
        app:title="游戏详情"
        app:titleTextColor="@color/text_primary"
        app:titleTextAppearance="@style/TextAppearance.Game100.Section"
        app:navigationIcon="@drawable/ic_back"
        app:navigationContentDescription="@string/back" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_panel"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:text="🎮"
                        android:textColor="@color/text_primary"
                        android:id="@+id/detail_icon"
                        android:gravity="center"
                        android:textSize="46sp"
                        android:background="@drawable/game_icon_bg"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="游戏名"
                            android:textColor="@color/text_primary"
                            android:id="@+id/detail_name"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="分类"
                            android:textColor="@color/brand"
                            android:id="@+id/detail_category"
                            android:layout_marginTop="9dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textSize="12sp"
                            android:background="@drawable/pill_secondary" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.Game100.Body"
                            android:id="@+id/detail_size"
                            android:layout_marginTop="7dp"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="24dp">
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:id="@+id/btn_play"
                        style="@style/Widget.Game100.PrimaryButton"
                        android:text="开始游戏"
                        android:layout_weight="1" />
                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:text="♡"
                        android:textColor="@color/text_secondary"
                        android:id="@+id/btn_favorite"
                        android:layout_marginStart="12dp"
                        android:gravity="center"
                        android:textSize="28sp"
                        android:background="@drawable/pill_secondary"
                        android:focusable="true"
                        android:clickable="true"
                        android:contentDescription="收藏游戏" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="下载到本机，没网也能玩"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Game100.Body"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_panel"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="游戏介绍"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.Game100.Section"
                    android:layout_marginBottom="12dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="暂无简介"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Game100.Body"
                    android:id="@+id/detail_desc"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/success"
                    android:id="@+id/detail_best_score"
                    android:layout_marginTop="18dp"
                    android:padding="14dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/pill_secondary"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_panel"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="这款游戏怎么样？"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.Game100.Section"
                    android:layout_marginBottom="12dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="记下你的体验，下次选游戏更轻松。"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Game100.Body" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:id="@+id/stars_row"
                    android:gravity="center"
                    android:layout_marginTop="12dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Game100.Body"
                    android:id="@+id/detail_rating_text"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
