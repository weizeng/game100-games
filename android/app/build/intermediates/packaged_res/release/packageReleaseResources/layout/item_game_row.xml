<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:padding="14dp"
    android:background="@drawable/surface_panel"
    android:foreground="?attr/selectableItemBackground"
    android:clipToOutline="true">
    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:importantForAccessibility="noHideDescendants">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/row_icon_bg" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮"
            android:textColor="@color/text_primary"
            android:id="@+id/row_icon"
            android:layout_gravity="center"
            android:textSize="30sp" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="游戏名"
            android:textColor="@color/text_primary"
            android:id="@+id/row_name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="分类"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Game100.Body"
            android:id="@+id/row_sub"
            android:layout_marginTop="5dp"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/accent"
            android:id="@+id/row_rating"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="开玩"
        android:textColor="@android:color/white"
        android:id="@+id/row_action"
        android:layout_marginStart="8dp"
        android:minWidth="60dp"
        android:minHeight="44dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/pill_action"
        android:textSize="13sp"
        android:textStyle="bold"
        android:focusable="true"
        android:clickable="true" />
</LinearLayout>
